datasource db {
  provider = "postgresql"
}

model products {
  id              BigInt            @id @default(autoincrement())
  sku             String            @unique @db.VarChar(100)
  barcode         String?           @db.VarChar(100)
  name            String            @db.VarChar(255)
  name_th         String?           @db.VarChar(255)
  category        String?           @db.VarChar(150)
  batch           String?           @db.VarChar(100)
  supplier        String?           @db.VarChar(255)
  unit            String            @db.VarChar(50)
  min_threshold   Decimal?          @default(0) @db.Decimal(14, 2)
  last_verified   DateTime?         @db.Timestamptz(6)
  verified_by     String?           @db.VarChar(200)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  stock_balances  stock_balances[]
  stock_movements stock_movements[]

  @@index([sku], map: "idx_products_sku")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_balances {
  id                  BigInt              @id @default(autoincrement())
  product_id          BigInt
  location_id         BigInt
  quantity            Decimal             @default(0) @db.Decimal(14, 2)
  updated_at          DateTime?           @default(now()) @db.Timestamptz(6)
  warehouse_locations warehouse_locations @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products            @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, location_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id                  BigInt               @id @default(autoincrement())
  product_id          BigInt
  location_id         BigInt?
  user_id             BigInt?
  action              String               @db.VarChar(30)
  delta               Decimal              @db.Decimal(14, 2)
  resulting_qty       Decimal              @db.Decimal(14, 2)
  note                String?
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  warehouse_locations warehouse_locations? @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products             @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_stock_movements_created")
  @@index([product_id], map: "idx_stock_movements_product")
}

model users {
  id              BigInt            @id @default(autoincrement())
  username        String            @unique @db.VarChar(100)
  password_hash   String
  full_name       String?           @db.VarChar(200)
  email           String?           @db.VarChar(200)
  role            String            @default("user") @db.VarChar(30)
  status          String            @default("Active") @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  stock_movements stock_movements[]
}

model warehouse_locations {
  id              BigInt            @id @default(autoincrement())
  zone            String            @db.VarChar(50)
  bin             String            @unique @db.VarChar(100)
  description     String?
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  stock_balances  stock_balances[]
  stock_movements stock_movements[]
}
